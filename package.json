{
  "name": "media-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun install && bun run db:push",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@elysiajs/cors": "^1.1.0",
    "@libsql/client": "^0.10.0",
    "drizzle-orm": "^0.33.0",
    "elysia": "^1.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
